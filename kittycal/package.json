{
  "name": "kittycal",
  "version": "1.0.0",
  "private": true,
  "description": "A free, private, offline-first cycle tracker. No dependencies, no build step.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "npx -y -p typescript@5 tsc --noEmit -p jsconfig.json",
    "serve": "python3 -m http.server 8080",
    "test:contrast": "node test/contrast.mjs http://127.0.0.1:8080",
    "test:network": "node test/network.mjs http://127.0.0.1:8080",
    "test:csv": "node test/csv.mjs http://127.0.0.1:8080"
  },
  "dependencies": {},
  "devDependencies": {}
}
